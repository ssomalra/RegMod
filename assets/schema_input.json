{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/regmod/master/assets/schema_input.json",
    "title": "nf-core/regmod pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
        "sample": {
            "type": "string",
            "pattern": "^\\S+$",
            "errorMessage": "Unique sample ID must be provided and cannot contain spaces",
            "meta": ["id"]
        },
		"condition": {
			"type": "string",
			"pattern": "^\\S+$",
			"description": "Experimental condition for the sample (e.g., control, treated)"
		},
		"replicate": {
			"type": "integer",
			"minimum": 1,
			"description": "Replicate number for the sample"
		},
        "fast5_dir": {
			"type": "string",
			"format": "directory-path",
			"exists": true,
			"pattern": "^\\S+$",
			"description": "Path to the FAST5 directory"
        },
	    "flowcell_id": {
	    	"type": "string",
			"pattern": "^\\S+$",
			"description": "Flowcell ID used for basecalling (e.g., FLO-MIN106, FLO-PRO002)"
	    },
	    "sequencing_kit": {
			"type": "string",
			"pattern": "^\\S+$",
			"description": "Sequencing kit used for basecalling (e.g., SQK-RNA002, SQK-LSK109)"
	    },
	    "reference": {
	        "type": "string",
			"format": "file-path",
			"exists": true,
 			"pattern": "^\\S+\\.(fa|fna|fasta)$",
			"description": "Path to the reference transcriptome"
	    },
	    "gtf": {
			"type": "string",
			"format": "file-path",
			"exists": true,
			"pattern": "^\\S+\\.gtf$",
			"description": "Path to the gene annotation file in GTF format"
	    }		
        },
    	"required": ["sample", "condition", "replicate", "fast5_dir", "flowcell_id", "sequencing_kit", "reference", "gtf"]
    }
}
